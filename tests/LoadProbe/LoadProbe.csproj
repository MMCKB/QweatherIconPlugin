<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LoadProbe</AssemblyName>
    <RootNamespace>LoadProbe</RootNamespace>
  </PropertyGroup>

  <!-- 这里刻意不使用 ExcludeAssets：需要把 ClassIsland.Core / Avalonia 等宿主程序集
       复制到输出目录，以模拟 ClassIsland 主程序默认加载上下文中的那些程序集。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.1.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.0" />
  </ItemGroup>

</Project>
